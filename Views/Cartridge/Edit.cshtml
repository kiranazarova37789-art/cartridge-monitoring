@model Project.DbModels.Cartridge

@{
    ViewBag.Title = "Редактирование картриджа";
}

<div class="container mt-4">
    <h2>Редактирование картриджа</h2>
    <hr />

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCr" />
        <input type="hidden" asp-for="QrCode" />
        <input type="hidden" asp-for="ModelId" />

        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 30%">Параметр</th>
                    <th>Значение</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ID картриджа</td>
                    <td><span class="badge bg-secondary">@Model.IdCr</span></td>
                </tr>

                @if (Model.QrCode != null)
                {
                    <tr>
                        <td>Текущий QR-код</td>
                        <td>
                            <img src="data:image/png;base64,@Convert.ToBase64String(Model.QrCode)" width="100" class="img-thumbnail" />
                        </td>
                    </tr>
                }

                <tr>
                    <td>Модель (Фирма + Номер)</td>
                    <td>
                        @{
                            var currentModel = (ViewBag.Models as IEnumerable<dynamic>)?.FirstOrDefault(m => m.Id == Model.ModelId);
                        }
                        <input type="text" class="form-control-plaintext fw-bold" value="@(currentModel?.FullName ?? "Модель не определена")" readonly />
                        <small class="text-muted text-uppercase" style="font-size: 0.75rem;">(Изменение модели запрещено)</small>
                    </td>
                </tr>

                <tr>
                    <td><label asp-for="StatusCr" class="control-label">Статус</label></td>
                    <td>
                        <select asp-for="StatusCr"
                                asp-items="Html.GetEnumSelectList<Project.DbModels.CartridgeStatus>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="StatusCr" class="text-danger"></span>
                    </td>
                </tr>

                <tr>
                    <td><label asp-for="LocationCr" class="control-label">Местонахождение</label></td>
                    <td>
                        <input asp-for="LocationCr" class="form-control" placeholder="Введите текущую локацию" />
                        <span asp-validation-for="LocationCr" class="text-danger"></span>
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save"></i> Сохранить изменения
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
