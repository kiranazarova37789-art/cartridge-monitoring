@model Project.DbModels.Cartridge
@using Project.DbModels

@{
    ViewBag.Title = "Добавление картриджа";

    var statuses = ((CartridgeStatus[])ViewBag.Statuses).Select(s => new SelectListItem
    {
        Value = s.ToString(),
        Text = s.ToString().Replace("_", " ")
    });

    var modelItems = ((IEnumerable<dynamic>)ViewBag.Models).Select(m => new SelectListItem
    {
        Value = m.Id.ToString(),
        Text = m.FullName
    });
}

<div class="container mt-3">
    <h2>Добавление картриджа</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(model => model.ModelId, "Модель и Фирма", new { @class = "control-label" })
                @Html.DropDownListFor(
                model => model.ModelId,
                                modelItems,
                                "-- Выберите модель --",
                                new { @class = "form-control" }
                                )
                @Html.ValidationMessageFor(model => model.ModelId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(model => model.StatusCr, "Статус", new { @class = "control-label" })
                @Html.DropDownListFor(
                                model => model.StatusCr,
                                statuses,
                                "Выберите статус",
                                new { @class = "form-control" }
                                )
                @Html.ValidationMessageFor(model => model.StatusCr, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(model => model.LocationCr, "Локация (Местонахождение)", new { @class = "control-label" })
                @Html.EditorFor(model => model.LocationCr, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.LocationCr, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Создать
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Назад
                </a>
            </div>
        </div>
    </form>
</div>
