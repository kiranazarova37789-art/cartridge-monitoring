@using Project.DbModels
@model Office

@{
    ViewData["Title"] = "Создать новый офис";
}

<h2>@ViewData["Title"]</h2>

<h4>Добавление нового офиса</h4>
<hr>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Parent" />

    <input type="hidden" asp-for="Level" />


    @if (Model?.Parent != null)
    {
        <div class="form-group">
            <label>Родительский офис</label>

            <input type="text" class="form-control" value="@ViewBag.ParentName" disabled />
        </div>
    }

    <div class="form-group">
        <label asp-for="Name">Название</label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>


    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
