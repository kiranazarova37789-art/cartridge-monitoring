@using Project.DbModels
@model IEnumerable<dynamic>

<link rel="stylesheet" href="~/css/printer.css" />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-4 border-end">

            <h4 class="mt-3">Кабинеты и принтеры</h4>
            <hr />

            <ul class="ps-2">
                @if (ViewBag.Offices != null)
                {
                    var rootOffices = ((List<Office>)ViewBag.Offices)
                        .Where(o => o.Parent == 0 || o.Parent == null)
                        .ToList();

                    foreach (var office in rootOffices)
                    {
                        @await Html.PartialAsync("_OfficeTreeItem", office)
                    }
                }
            </ul>

        </div>

        <div class="col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h2>Список принтеров</h2>

                <div class="btn-group">

                    <button type="button"
                            onclick="printFilteredQr()"
                            class="btn btn-primary">
                        <i class="bi bi-printer"></i>
                        Печать отфильтрованных
                    </button>

                    <a asp-action="Create"
                       class="btn btn-success">
                        <i class="bi bi-plus-circle"></i>
                        Добавить
                    </a>

                </div>

            </div>

            <div class="d-flex gap-2 mb-2">

                <select id="modelFilter"
                        class="form-select form-select-sm"
                        onchange="filterPrinterTable()">

                    <option value="">Все модели</option>

                    @foreach (var m in Model
                        .Select(i => i.ModelName)
                        .Distinct()
                        .OrderBy(x => x))
                    {
                        <option value="@m">@m</option>
                    }

                </select>

                <select id="cartridgeFilter"
                        class="form-select form-select-sm"
                        onchange="filterPrinterTable()">

                    <option value="">Наличие картриджа (Все)</option>
                    <option value="true">Есть</option>
                    <option value="false">Нет</option>

                </select>

            </div>

            <table class="table table-hover align-middle"
                   style="font-size: 0.9rem;"
                   id="printerTable">

                <thead class="table-light">

                    <tr>
                        <th>ID</th>
                        <th>Модель</th>
                        <th>IP адрес</th>
                        <th>Картридж</th>
                        <th>QR</th>
                        <th>Действия</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="printer-row"
                            data-id="@item.IdPrint"
                            data-model="@item.ModelName"
                            data-cartridge="@item.HasCartridge.ToString().ToLower()">

                            <td>
                                @item.IdPrint
                            </td>

                            <td>
                                <strong>@item.ModelName</strong>
                            </td>

                            <td>
                                @item.Ip
                            </td>

                            <td>
                                @(item.HasCartridge ? "Есть" : "Нет")
                            </td>

                            <td class="text-center">

                                @if (item.qr != null && item.qr.Length > 0)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(item.qr)"
                                         class="printer-qr-preview" />
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-1">

                                    @if (item.qr != null && item.qr.Length > 0)
                                    {
                                        <button type="button"
                                                onclick="printSingleQr('@item.IdPrint')"
                                                class="btn btn-info btn-sm text-white px-3">
                                            Печать
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="ShowQr"
                                           asp-route-id="@item.IdPrint"
                                           class="btn btn-sm btn-info text-white px-3">
                                            Create QR
                                        </a>
                                    }

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdPrint"
                                       class="btn btn-primary btn-sm px-3">
                                        Редактировать
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.IdPrint"
                                          method="post"
                                          onsubmit="return confirm('Удалить принтер?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm px-3">
                                            Удалить
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>


<div class="print-zone" id="mass-print-zone">

    @foreach (var item in Model)
    {
        if (item.qr != null && item.qr.Length > 0)
        {
            <div class="print-sticker"
                 id="sticker-@item.IdPrint">

                <div class="qr-wrapper">

                    <img src="data:image/png;base64,@Convert.ToBase64String(item.qr)" />

                </div>

                <div class="info-wrapper">

                    <div class="p-id">
                        ID: @item.IdPrint
                    </div>

                    <div class="p-model">
                        @item.ModelName
                    </div>

                    <div class="p-ip">
                        @item.Ip
                    </div>

                </div>

            </div>
        }
    }

</div>

@section Scripts
{
    <script src="~/js/printer.js"></script>
}