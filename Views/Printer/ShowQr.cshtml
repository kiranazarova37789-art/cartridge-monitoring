@{
    ViewData["Title"] = "QR Код Принтера";
}

<div class="text-center">
    <h1>QR Код для принтера @ViewBag.PrinterIp</h1>
    <hr />
    <div class="mt-4">
        <img src="@ViewBag.QrCode" style="width: 300px; height: 300px; border: 1px solid #ccc;" />
    </div>
    <div class="mt-4">
        <button onclick="window.print()" class="btn btn-primary">Распечатать</button>
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>
