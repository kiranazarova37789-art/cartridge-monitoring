@using Project.DbModels
@model IEnumerable<Office>

@if (Model != null && Model.Any())
{
    <ul style="list-style: none; padding-left: 25px;">
        @foreach (var room in Model)
        {
            <li>
                Кабинет <strong>@room.Name</strong>
                <form asp-action="Delete" asp-controller="Office" method="post" style="display: inline;">
                    <input type="hidden" name="id" value="@room.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Вы уверены, что хотите удалить кабинет: @room.Name?')">
                        Удалить
                    </button>
                </form>
            </li>
        }
    </ul>
}
